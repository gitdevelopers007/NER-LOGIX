# ==========================================
# NER-LOGIX ENVIRONMENT CONFIGURATION (TEMPLATE)
# Copy this file to .env: cp .env.example .env
# ==========================================

# Frontend Configuration (Vite)
VITE_APP_TITLE=NER-LOGIX
VITE_API_URL=http://localhost:3001
VITE_GIS_TILE_PROVIDER=openstreetmap
VITE_ENVIRONMENT=development

# Backend Server Configuration (Express)
PORT=3001
NODE_ENV=development
JWT_SECRET=your_jwt_secret_key_here

# Optional / External GIS Telemetry Gateways (Defaults to Free Open-Source OSM / Bhuvan)
BHUVAN_GEOPORTAL_URL=https://bhuvan-app3.nrsc.gov.in
IMD_WEATHER_RADAR_URL=https://mausam.imd.gov.in
